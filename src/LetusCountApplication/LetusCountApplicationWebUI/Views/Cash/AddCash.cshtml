@model CashViewModel


<div class="wrapper">
    <div class="page-body">
        <div class="configure-page-header">
            <h4>Добавление кассы</h4>
        </div>
        <div class="form-page-body">
            <div class="text_error message">
                @Html.ValidationMessage("Error")
            </div>
            <form class="form block-background" method="post" asp-controller="Cash" asp-action="AddCash">
                <div class="form-label">
                    <input class="form-field" asp-for="Name" placeholder="Введите наименование кассы." />
                    <span asp-validation-for="Name" class="text_error"></span>
                </div>
                <input type="hidden" asp-for="DepartmentId" />
                <div class="form-label">
                    <select class="form-field" asp-for="SelectedCashMachineId" asp-items="Model.CashMachines">
                        <option value="">Выберите Kisan, либо добавьте позднее</option>
                    </select>
                </div>
                <div class="form-button">
                    <input class="form-enter-button form-field" type="submit" value="Создать" />
                </div>
            </form>
        </div>
    </div>
</div>

@section css {
    <link href="~/css/configuration.css" rel="stylesheet" asp-append-version="true" />
}