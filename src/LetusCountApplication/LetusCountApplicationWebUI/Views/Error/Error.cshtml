<div class="wrapper">
	<div class="page-body">
﻿﻿@if (ViewBag.ErrorTitle == null)
{
    <div class="page-header">
        <h4 class="error-title">Ошибка</h4>
    </div>
    <div class="error_mesage nonfound-message block-background">
        <h3 class="error_text">
            Ошибка запроса, пожалуйста свяжитесь со службой технической поддержки.
        </h3>
    </div>
}
else
{
    <div class="page-header">
        <h4 class="error-title"> @ViewBag.ErrorTitle </h4>
    </div>
    <div class="error_mesage nonfound-message block-background">        
        <h3 class="error_text">@ViewBag.ErrorMessage</h3>
    </div>
}
</div>
</div>

@section css {
    <link href="~/css/error.css" rel="stylesheet" asp-append-version="true" />
}