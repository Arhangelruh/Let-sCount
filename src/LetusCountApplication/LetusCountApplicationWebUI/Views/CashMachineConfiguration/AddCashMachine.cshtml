@model CashMachineViewModel


<div class="wrapper">
    <div class="page-body">
        <div class="configure-page-header">
            <h4>Добавление Kisan</h4>
        </div>
        <div class="form-page-body">
			<div class="text_error message">
				@Html.ValidationMessage("Error")
			</div>
          <form class="form block-background" method="post" asp-controller="CashMachineConfiguration" asp-action="AddCashMachine">
            <div class="form-label">
               <input class="form-field" asp-for="Serial" placeholder="Введите серийный номер." />
               <span asp-validation-for="Serial" class="text_error"></span>
            </div>
            <div class="form-label">
               <input class="form-field" asp-for="Number" placeholder="Введите инвентарный номер." />
               <span asp-validation-for="Number" class="text_error"></span>
            </div>
            <div class="form-button">
                    <input class="form-enter-button form-field" type="submit" value="Создать" />
            </div>
          </form>
       </div>
    </div>
</div>

@section css {
	<link href="~/css/configuration.css" rel="stylesheet" asp-append-version="true" />
}