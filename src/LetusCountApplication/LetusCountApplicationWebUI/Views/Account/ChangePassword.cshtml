@model ChangePasswordViewModel

<div class="wrapper">
    <div class="page-body">
        <div class="page-header">
            <h4>Изменение пароля.</h4>
        </div>
        <div class="page-body">
            <form class="form" asp-action="ChangePassword" asp-controller="Account">
               <div asp-validation-summary="All" class="text_error"></div>
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="UserName" />
                <div class="forms-label">
                    <input class="forms-field" type="text" asp-for="OldPassword" placeholder="Старый пароль" />
                </div>
                <div class="forms-label">
                    <input class="forms-field" type="text" asp-for="NewPassword" placeholder="Новый пароль" />
                </div>
                 <div class="forms-label">
                    <input type="submit" value="Сохранить" class="button_classic" />
                </div>
            </form>
        </div>
    </div>
</div>

@section css {
    <link href="~/css/user.css" rel="stylesheet" asp-append-version="true" />
}