@model IEnumerable<UserViewModel>

<div class="wrapper">
<div class="page-body">
    <div class="page-header">
        <h4>Пользователи.</h4>
    </div>
    <div class="page-body">        
        <div class="users-table">
                <a asp-controller="Profile" asp-action="CreateUser">
                    <div class="adding-button block-background">
                        <img class="adding-button-picture" src="~/images/Add_Button.svg" />
                    </div>
                </a>
                <table class="table block-background">
                  <tr>
                    <th>Имя пользователя</th>
                    <th>ФИО</th>
                    <th>Роль</th>
                    <th>Статус</th>
                  </tr>
                   @foreach (var profile in Model)
                    {
                    <tr>
                        <td>@profile.Login</td>
                        <td>@profile.LastName @profile.FirstName @profile.MiddleName</td>
                        <td>@profile.IsAdmin</td>
                        <td>
                        @if (profile.Locking)
                        {
                            <a asp-controller="Profile" asp-action="Unlock" asp-route-id="@profile.Id">
                                <img title="Разблокировать" src="/images/Lock.svg" />
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Profile" asp-action="Lock" asp-route-id="@profile.Id">
                                <img title="Заблокировать" src="/images/Unlock.svg" />
                            </a>
                        }
                        </td>
                        <td>
                            <a asp-controller="Profile" asp-action="EditUser" asp-route-id="@profile.Id">
                                <img title="Изменить" src="/images/Edit.svg" />
                            </a>
                        </td>
                        <td>
                            <a asp-controller="Profile" asp-action="DeleteUser" asp-route-id="@profile.Id">
                            <img title="Удалить" src="/images/Delete.svg" />
                            </a>
                        </td>
                    </tr>
                    }
                </table>
        </div>
    </div>
</div>
</div>

@section css {
    <link href="~/css/user.css" rel="stylesheet" asp-append-version="true" />
}